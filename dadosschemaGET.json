{
  "$id": "https://ipen.sc.gov.br/api/monitorados.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dados Monitorados API Response",
  "description": "Schema para resposta da API para preencher formulários do monitoramento",
  "type": "object",
  "required": ["success", "total", "dados_monitorados"],
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Indica se a requisição foi bem-sucedida"
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "description": "Número total de registros retornados"
    },
    "dados_monitorados": {
      "type": "array",
      "description": "Lista de pessoas monitoradas",
      "items": {
        "$ref": "#/$defs/monitorado"
      }
    }
  },
  "$defs": {
    "monitorado": {
      "type": "object",
      "required": [
        "matricula_ipen",
        "nome_civil",
        "cpf",
        "sexo",
        "data_nascimento",
        "naturalidade",
        "uf",
        "nacionalidade"
      ],
      "properties": {
        "matricula_ipen": {
          "type": "integer",
          "minimum": 400000,
          "maximum": 999999,
          "description": "Matrícula IPEN com 6 dígitos"
        },
        "nome_civil": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "Nome civil completo da pessoa"
        },
        "nome_social": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Nome social da pessoa (pode ser null ou 'None')"
        },
        "cpf": {
          "type": "string",
          "pattern": "^[0-9]{3}\\.[0-9]{3}\\.[0-9]{3}-[0-9]{2}$",
          "description": "CPF no formato XXX.XXX.XXX-XX"
        },
        "rg": {
          "type": ["string", "null"],
          "pattern": "^[A-Z]{2}-[0-9]{2}\\.[0-9]{3}\\.[0-9]{3}$",
          "description": "RG no formato UF-XX.XXX.XXX. (pode ser null ou 'None' caso esteja no novo formato de identificação)"
        },
        "sexo": {
          "type": "string",
          "enum": ["Masculino", "Feminino", "Não Informado"],
          "description": "Sexo biológico da pessoa"
        },
        "raca_cor": {
          "type": "string",
          "maxLength": 2,
          "enum": ["BC", "PD", "PR", "IN", "AM", "ND"],
          "description": "Raça/Cor: BC=Branco(a), PD=Pardo(a), PR=Preto(a), IN=Indígena, AM=Amarelo(a), ND=Não declarado",
          "$comment": "Segue um padrão utilizado pelo dataJUD"
        },
        "estado_civil": {
          "type": "string",
          "maxLength": 2,
          "enum": ["SO", "CA", "DI", "VI", "UE", "NI"],
          "description": "Estado civil da pessoa: SO=Solteiro(a), CA=Casado(a), DI=Divorciado(a), VI=Viúvo(a), UE=União Estável, NI=Não Informado"
        },
        "conjuge": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Nome do cônjuge (pode ser null ou 'None')"
        },
        "pai": {
          "type": ["string", "null"],
          "maxLength": 200,
          "description": "Nome do pai"
        },
        "mae": {
          "type": ["string"],
          "maxLength": 200,
          "description": "Nome da mãe"
        },
        "data_nascimento": {
          "type": "string",
          "pattern": "^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/[0-9]{4}$",
          "description": "Data de nascimento no formato DD/MM/AAAA"
        },
        "idade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "description": "Idade calculada em anos"
        },
        "naturalidade": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Cidade de nascimento"
        },
        "uf": {
          "type": "string",
          "maxLength": 2,
          "pattern": "^[A-Z]{2}$",
          "description": "Unidade Federativa (sigla com 2 letras)"
        },
        "nacionalidade": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "maxLength": 3,
          "description": "Sigla da nacionalidade (3 letras), ISO 3166-1 alpha-3"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}